# apps/admin/.env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DB_LIMIT_MB=500
# Never put the service-role key here. The admin app only calls admin_* database functions, which enforce role + MFA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_MEDIA_URL=  # media Worker URL, so moderators can see images in the review queue
NEXT_PUBLIC_BILLING_URL=  # billing Worker URL: lets finance admins start refunds from the Orders screen
