NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never put the service-role key in any client or NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SITE_URL=https://your-domain (used for share links and preview images)
NEXT_PUBLIC_RANDOM_WS_URL=wss://your-worker.workers.dev (random chat Worker, see cloudflare/workers/random)
NEXT_PUBLIC_MEDIA_URL=https://your-media-worker.workers.dev (media Worker, see cloudflare/workers/media; image uploads are hidden if unset)
NEXT_PUBLIC_AI_URL=https://your-ai-worker.workers.dev (AI Worker, see cloudflare/workers/ai; the AI Companion is hidden if unset)
NEXT_PUBLIC_BILLING_URL=https://your-billing-worker.workers.dev (billing Worker, see cloudflare/workers/billing; Plus is hidden if unset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=  (optional: Cloudflare Turnstile site key. Turn on CAPTCHA in Supabase Auth with the matching secret to stop bots creating anonymous accounts)
NEXT_PUBLIC_DM_URL=https://your-dm-worker.workers.dev (DM Worker, see cloudflare/workers/dm; direct messages are hidden if unset)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=  (push notifications: public key from `node cloudflare/workers/push/generate-vapid.mjs`; hidden if unset)
